# Canonical origin. Defaults to https://bayoudry.com when unset.
NEXT_PUBLIC_SITE_URL=

# Main phone: display + E.164. Unset = temporary (713) 555-0148 placeholder,
# which is EXCLUDED from structured data.
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_PHONE_E164=

# Call-tracking number shown on /lp/* pages only.
NEXT_PUBLIC_PPC_TRACKING_PHONE=

NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_HOURS=

# Contractor license — shown + schema'd ONLY when set. Never invent one.
NEXT_PUBLIC_LICENSE_NUMBER=

# Real staffed office only. Empty = service-area business.
NEXT_PUBLIC_OFFICE_ADDRESS=

# "true" ONLY if 24/7 dispatch is actually staffed.
NEXT_PUBLIC_EMERGENCY_24_7=

NEXT_PUBLIC_GOOGLE_REVIEW_URL=
NEXT_PUBLIC_GOOGLE_PROFILE_URL=

NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Lead delivery: HMAC-signed webhook. Production refuses leads with no destination.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
DATABASE_URL=
